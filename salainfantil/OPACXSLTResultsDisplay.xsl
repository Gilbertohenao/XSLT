<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:marc="http://www.loc.gov/MARC21/slim" xmlns:items="http://www.koha-community.org/items" exclude-result-prefixes="marc items">
<xsl:output method="html" encoding="UTF-8" omit-xml-declaration="yes"/>
<xsl:strip-space elements="*"/>
<xsl:variable name="UC" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÜÑ'"/><xsl:variable name="LC" select="'abcdefghijklmnopqrstuvwxyzáéíóúüñ'"/>
<xsl:template match="/"><xsl:apply-templates select="marc:record | marc:collection/marc:record | collection/marc:record"/></xsl:template>
<xsl:template match="marc:record">
<xsl:variable name="biblionumber" select="normalize-space(marc:datafield[@tag='999'][1]/marc:subfield[@code='c'][1])"/>
<xsl:variable name="title" select="marc:datafield[@tag='245'][1]"/>
<xsl:variable name="genreRaw" select="normalize-space(marc:datafield[@tag='084'][1]/marc:subfield[@code='a'][1])"/>
<xsl:variable name="genre" select="substring-before(concat(translate($genreRaw,$LC,$UC),' '),' ')"/>
<xsl:variable name="available" select="count(items:items/items:item[items:status='available'])"/>
<xsl:variable name="itemcount" select="count(items:items/items:item)"/>
<article class="bnc-mini-result"><xsl:attribute name="style">--genre-color:<xsl:call-template name="genre-color"><xsl:with-param name="code" select="$genre"/></xsl:call-template>;</xsl:attribute>
<p class="bnc-mini-title"><a href="/cgi-bin/koha/opac-detail.pl?biblionumber={$biblionumber}"><xsl:choose><xsl:when test="$title/marc:subfield[@code='a']"><xsl:value-of select="normalize-space($title/marc:subfield[@code='a'][1])"/></xsl:when><xsl:otherwise>Sin título</xsl:otherwise></xsl:choose><xsl:if test="$title/marc:subfield[@code='b']"><xsl:text> </xsl:text><xsl:value-of select="normalize-space($title/marc:subfield[@code='b'][1])"/></xsl:if></a><xsl:if test="$title/marc:subfield[@code='c']"><xsl:text> </xsl:text><span class="bnc-mini-title__responsibility"><xsl:value-of select="normalize-space($title/marc:subfield[@code='c'][1])"/></span></xsl:if></p>
<div class="bnc-mini-meta">
<xsl:if test="marc:datafield[@tag='250'][1]/marc:subfield[@code='a' or @code='b']"><p class="bnc-mini-line bpc-mini-publine"><span class="bnc-mini-label">Edición</span><span class="bpc-mini-pubvalue"><xsl:for-each select="marc:datafield[@tag='250'][1]/marc:subfield[@code='a' or @code='b']"><xsl:if test="position() &gt; 1"><xsl:text> </xsl:text></xsl:if><xsl:value-of select="normalize-space(.)"/></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[@tag='264' or @tag='260'][marc:subfield[@code='a' or @code='b' or @code='c']][1]/marc:subfield[@code='a' or @code='b' or @code='c']"><p class="bnc-mini-line bpc-mini-publine"><span class="bnc-mini-label">Publicación</span><span class="bpc-mini-pubvalue"><xsl:for-each select="marc:datafield[@tag='264' or @tag='260'][marc:subfield[@code='a' or @code='b' or @code='c']][1]/marc:subfield[@code='a' or @code='b' or @code='c']"><xsl:if test="position() &gt; 1"><xsl:text> </xsl:text></xsl:if><xsl:value-of select="normalize-space(.)"/></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[@tag='490'][marc:subfield[@code='a' or @code='v']][1]/marc:subfield[@code='a' or @code='v'] or marc:datafield[@tag='830'][marc:subfield[@code='a' or @code='v']][1]/marc:subfield[@code='a' or @code='v']"><p class="bnc-mini-line bpc-mini-publine"><span class="bnc-mini-label">Serie</span><span class="bpc-mini-pubvalue"><xsl:choose><xsl:when test="marc:datafield[@tag='490'][marc:subfield[@code='a' or @code='v']][1]/marc:subfield[@code='a' or @code='v']"><xsl:for-each select="marc:datafield[@tag='490'][marc:subfield[@code='a' or @code='v']][1]/marc:subfield[@code='a' or @code='v']"><xsl:if test="position() &gt; 1"><xsl:text> ; </xsl:text></xsl:if><xsl:value-of select="normalize-space(.)"/></xsl:for-each></xsl:when><xsl:otherwise><xsl:for-each select="marc:datafield[@tag='830'][marc:subfield[@code='a' or @code='v']][1]/marc:subfield[@code='a' or @code='v']"><xsl:if test="position() &gt; 1"><xsl:text> ; </xsl:text></xsl:if><xsl:value-of select="normalize-space(.)"/></xsl:for-each></xsl:otherwise></xsl:choose></span></p></xsl:if>

<xsl:if test="marc:datafield[@tag='521'][1]/marc:subfield[@code='a' or @code='b']"><p class="bnc-mini-line"><span class="bnc-mini-label">Edad</span><span><xsl:for-each select="marc:datafield[@tag='521'][1]/marc:subfield[@code='a' or @code='b']"><xsl:value-of select="normalize-space(.)"/><xsl:if test="position()!=last()"><xsl:text> </xsl:text></xsl:if></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[@tag='520'][1]/marc:subfield[@code='a' or @code='b']"><p class="bnc-mini-line bnc-mini-summary"><span class="bnc-mini-label">Resumen</span><span><xsl:for-each select="marc:datafield[@tag='520'][1]/marc:subfield[@code='a' or @code='b']"><xsl:value-of select="normalize-space(.)"/><xsl:if test="position()!=last()"><xsl:text> </xsl:text></xsl:if></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[@tag='505'][1]/marc:subfield[@code='a' or @code='g' or @code='r' or @code='t']"><p class="bnc-mini-line bnc-mini-contents"><span class="bnc-mini-label">Contenido</span><span><xsl:for-each select="marc:datafield[@tag='505'][1]/marc:subfield[@code='a' or @code='g' or @code='r' or @code='t']"><xsl:value-of select="normalize-space(.)"/><xsl:if test="position()!=last()"> — </xsl:if></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[@tag='300'][1]/marc:subfield[@code='a' or @code='b' or @code='c']"><p class="bnc-mini-line"><span class="bnc-mini-label">Descripción</span><span><xsl:for-each select="marc:datafield[@tag='300'][1]/marc:subfield[@code='a' or @code='b' or @code='c']"><xsl:value-of select="normalize-space(.)"/><xsl:if test="position()!=last()"><xsl:text> </xsl:text></xsl:if></xsl:for-each></span></p></xsl:if>
<xsl:if test="marc:datafield[starts-with(@tag,'6') and not(@tag='655')][marc:subfield[@code='a']]"><div class="bnc-mini-line bnc-mini-subjects"><span class="bnc-mini-label">Temas</span><span class="bnc-mini-chipline"><xsl:for-each select="marc:datafield[starts-with(@tag,'6') and not(@tag='655')][marc:subfield[@code='a']][position() &lt;= 3]"><span class="bnc-mini-chip"><xsl:call-template name="field-string"><xsl:with-param name="field" select="."/></xsl:call-template></span></xsl:for-each></span></div></xsl:if>
</div>
<div class="bnc-mini-footer"><xsl:if test="$genreRaw!=''"><span class="bnc-mini-genre"><xsl:choose><xsl:when test="$genre='A'">Álbum</xsl:when><xsl:when test="$genre='C'">Cuento</xsl:when><xsl:when test="$genre='H'">Historieta</xsl:when><xsl:when test="$genre='LM'">Leyenda y mitología</xsl:when><xsl:when test="$genre='N'">Novela</xsl:when><xsl:when test="$genre='NG'">Novela gráfica</xsl:when><xsl:when test="$genre='P'">Poesía</xsl:when><xsl:when test="$genre='T'">Teatro</xsl:when><xsl:otherwise><xsl:value-of select="$genreRaw"/></xsl:otherwise></xsl:choose></span></xsl:if>
<xsl:choose><xsl:when test="$available&gt;0"><span class="bnc-mini-availability is-available"><xsl:value-of select="$available"/> disponible</span></xsl:when><xsl:when test="$itemcount&gt;0"><span class="bnc-mini-availability is-unavailable">No disponible</span></xsl:when><xsl:otherwise><span class="bnc-mini-availability is-unknown">Consultar disponibilidad</span></xsl:otherwise></xsl:choose></div>
</article></xsl:template>
<xsl:template name="field-string"><xsl:param name="field"/><xsl:for-each select="$field/marc:subfield[not(@code='0' or @code='1' or @code='2' or @code='3' or @code='4' or @code='5' or @code='6' or @code='8' or @code='i' or @code='w')]"><xsl:if test="position() &gt; 1"><xsl:text> </xsl:text></xsl:if><xsl:value-of select="normalize-space(.)"/></xsl:for-each></xsl:template>
<xsl:template name="genre-color"><xsl:param name="code"/><xsl:choose><xsl:when test="$code='A' or $code='ALB' or $code='ALBUM'">#f2c529</xsl:when><xsl:when test="$code='C'">#65b94b</xsl:when><xsl:when test="$code='H'">#ef4555</xsl:when><xsl:when test="$code='LM'">#f28536</xsl:when><xsl:when test="$code='N'">#3b82e6</xsl:when><xsl:when test="$code='NG'">#e149a6</xsl:when><xsl:when test="$code='P'">#d982bd</xsl:when><xsl:when test="$code='T'">#8d9096</xsl:when><xsl:otherwise>#FFFFFF</xsl:otherwise></xsl:choose></xsl:template>
</xsl:stylesheet>